{
  "pinned-apps": {
    "type": "generic",
    "default": [
      "nemo.desktop",
      "com.mitchellh.ghostty.desktop",
      "heidisql.desktop",
      "chrome-cinhimbnkkaeohfgghhklpknlkffjgod-Default.desktop",
      "chrome-lcmninomimaabkahifgablgmjeldgkhm-Profile_3.desktop",
      "chrome-pommaclcbfghclhalboakcipcmmndhcj-Profile_3.desktop"
    ]
  },
  "recent-apps": {
    "type": "generic",
    "default": []
  },
  "position": {
    "type": "combobox",
    "description": "Posição na tela",
    "default": "bottom",
    "options": {
      "Inferior": "bottom",
      "Esquerda": "left",
      "Direita": "right"
    }
  },
  "icon-size": {
    "type": "spinbutton",
    "description": "Tamanho dos ícones",
    "default": 48,
    "min": 24,
    "max": 96,
    "step": 2,
    "units": "px"
  },
  "magnification": {
    "type": "switch",
    "description": "Ampliar ícones sob o cursor",
    "default": true
  },
  "magnification-size": {
    "type": "spinbutton",
    "description": "Tamanho máximo da ampliação",
    "default": 72,
    "min": 24,
    "max": 128,
    "step": 2,
    "units": "px",
    "dependency": "magnification"
  },
  "icon-appearance": {
    "type": "combobox",
    "description": "Aparência dos ícones",
    "default": "default",
    "options": {
      "Padrão": "default",
      "Clara": "light",
      "Escura": "dark",
      "Tonalizada": "tinted",
      "Transparente": "clear"
    }
  },
  "icon-tint": {
    "type": "colorchooser",
    "description": "Cor dos ícones tonalizados",
    "default": "rgb(10,132,255)",
    "dependency": "icon-appearance=tinted"
  },
  "glass-blur": {
    "type": "switch",
    "description": "Desfocar o fundo do vidro (experimental)",
    "tooltip": "Desfoca o papel de parede atrás do Dock. Quando há uma janela atrás dele, usa o vidro simples.",
    "default": false
  },
  "autohide": {
    "type": "switch",
    "description": "Ocultar automaticamente",
    "default": false
  },
  "current-workspace-only": {
    "type": "switch",
    "description": "Mostrar apenas apps da área de trabalho atual",
    "tooltip": "Desligado, como no macOS, o Dock mostra os apps de todas as áreas de trabalho.",
    "default": false
  },
  "show-recent-apps": {
    "type": "switch",
    "description": "Mostrar apps recentes",
    "tooltip": "Até 3 apps não fixados fechados há pouco, depois dos apps abertos.",
    "default": true
  },
  "minimize-into-icon": {
    "type": "switch",
    "description": "Minimizar janelas no ícone do app",
    "tooltip": "Desligado, cada janela minimizada ganha uma miniatura própria antes da lixeira, como no macOS.",
    "default": true
  },
  "show-downloads": {
    "type": "switch",
    "description": "Mostrar a pasta Downloads",
    "default": true
  },
  "folders": {
    "type": "list",
    "description": "Pastas no Dock",
    "tooltip": "Cada pasta abre como uma pilha antes da lixeira. A ordenação e a visualização ficam no menu de contexto dela.",
    "columns": [
      { "id": "uri", "title": "Pasta", "type": "file", "select-dir": true }
    ],
    "default": []
  },
  "stack-options": {
    "type": "generic",
    "default": {}
  },
  "focus-hotkey": {
    "type": "keybinding",
    "description": "Focar o Dock pelo teclado",
    "default": "<Super><Alt>d"
  }
}
