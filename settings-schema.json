{
  "pinned-apps": {
    "type": "generic",
    "default": [
      "nemo.desktop",
      "com.mitchellh.ghostty.desktop",
      "heidisql.desktop",
      "chrome-cinhimbnkkaeohfgghhklpknlkffjgod-Default.desktop",
      "chrome-lcmninomimaabkahifgablgmjeldgkhm-Profile_3.desktop",
      "chrome-pommaclcbfghclhalboakcipcmmndhcj-Profile_3.desktop"
    ]
  },
  "recent-apps": {
    "type": "generic",
    "default": []
  },
  "position": {
    "type": "combobox",
    "description": "Posição na tela",
    "default": "bottom",
    "options": {
      "Inferior": "bottom",
      "Esquerda": "left",
      "Direita": "right"
    }
  },
  "icon-size": {
    "type": "spinbutton",
    "description": "Tamanho dos ícones",
    "default": 48,
    "min": 24,
    "max": 96,
    "step": 2,
    "units": "px"
  },
  "magnification": {
    "type": "switch",
    "description": "Ampliar ícones sob o cursor",
    "default": true
  },
  "magnification-size": {
    "type": "spinbutton",
    "description": "Tamanho máximo da ampliação",
    "default": 72,
    "min": 24,
    "max": 128,
    "step": 2,
    "units": "px",
    "dependency": "magnification"
  },
  "autohide": {
    "type": "switch",
    "description": "Ocultar automaticamente",
    "default": false
  },
  "current-workspace-only": {
    "type": "switch",
    "description": "Mostrar apenas apps da área de trabalho atual",
    "tooltip": "Desligado, como no macOS, o Dock mostra os apps de todas as áreas de trabalho.",
    "default": false
  },
  "show-recent-apps": {
    "type": "switch",
    "description": "Mostrar apps recentes",
    "tooltip": "Até 3 apps não fixados fechados há pouco, depois dos apps abertos.",
    "default": true
  },
  "focus-hotkey": {
    "type": "keybinding",
    "description": "Focar o Dock pelo teclado",
    "default": "<Super><Alt>d"
  }
}
